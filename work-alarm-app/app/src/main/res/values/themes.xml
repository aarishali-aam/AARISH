<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WorkAlarm" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <style name="Theme.WorkAlarm.FullScreenAlarm" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
    </style>
</resources>
